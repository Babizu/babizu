{
  "format": "babizu-playground-project",
  "version": 1,
  "title": {
    "zh-TW": "示範語（範例專案）",
    "en": "Demo language (sample project)"
  },
  "description": {
    "zh-TW": "虛構的小語言：北部、南部兩種方言與一種地方變體，有前綴、後綴、中綴與重疊。只用來展示 babizu，與任何真實的語言無關。",
    "en": "A made-up little language with northern and southern dialects, one local variety, and prefixes, suffixes, an infix and reduplication. For showing babizu only; it is not a real language."
  },
  "varieties": [
    {
      "code": "north",
      "label": {
        "zh-TW": "北部",
        "en": "Northern"
      },
      "hue": 265
    },
    {
      "code": "south",
      "label": {
        "zh-TW": "南部",
        "en": "Southern"
      },
      "hue": 150
    },
    {
      "code": "coast",
      "parent": "south",
      "label": {
        "zh-TW": "南部（海岸）",
        "en": "Southern (coastal)"
      }
    }
  ],
  "profile": {
    "format": "babizu-language-profile",
    "version": 1,
    "normalizer": {
      "lowercase": true,
      "charMap": {
        "ʔ": "'"
      },
      "stripDiacritics": true
    },
    "costs": {
      "substitute": 1.5,
      "delete": 1,
      "insert": 0.8,
      "overrides": {
        " ": {
          "delete": 0.1,
          "insert": 0.1
        }
      }
    },
    "rules": [
      {
        "category": "流音",
        "label": {
          "en": "Liquids"
        },
        "description": "北部說 r、南部說 l",
        "rules": [
          [
            "r",
            "l",
            0.1
          ]
        ]
      },
      {
        "category": "詞尾",
        "label": {
          "en": "Word-final"
        },
        "position": "final",
        "rules": [
          [
            "n",
            "ng",
            0.1
          ],
          [
            "h",
            "",
            0.1
          ],
          [
            "'",
            "",
            0.1
          ]
        ]
      },
      {
        "category": "元音",
        "label": {
          "en": "Vowels"
        },
        "rules": [
          [
            "e",
            "i",
            0.2
          ],
          [
            "o",
            "u",
            0.2
          ]
        ]
      }
    ],
    "morphology": {
      "minStem": 3,
      "prefixes": [
        {
          "form": "ma",
          "gloss": "主事"
        },
        {
          "form": "pa",
          "gloss": "使動"
        }
      ],
      "suffixes": [
        {
          "form": "an",
          "gloss": "處所"
        }
      ],
      "infixes": [
        {
          "form": "in",
          "gloss": "完成"
        }
      ],
      "reduplication": [
        {
          "pattern": "CV"
        }
      ]
    }
  },
