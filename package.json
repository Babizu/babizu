{
  "name": "babizu",
  "version": "0.11.0",
  "description": "多語言、可溯源的辭典網站框架：跨方言加權模糊搜尋、標準語料格式、多語系介面、靜態部署",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Babizu/babizu.git"
  },
  "bin": {
    "babizu": "./bin/babizu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "babizu-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fuzzy": {
      "types": "./packages/bcdp/dist/index.d.ts",
      "babizu-source": "./packages/bcdp/src/index.ts",
      "default": "./packages/bcdp/dist/index.js"
    },
    "./fst": {
      "types": "./packages/bcdp/dist/fst/index.d.ts",
      "babizu-source": "./packages/bcdp/src/fst/index.ts",
      "default": "./packages/bcdp/dist/fst/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "babizu-source": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/constants": {
      "types": "./dist/schema/constants.d.ts",
      "babizu-source": "./src/schema/constants.ts",
      "default": "./dist/schema/constants.js"
    },
    "./schema/types": {
      "types": "./dist/schema/types.d.ts",
      "babizu-source": "./src/schema/types.ts",
      "default": "./dist/schema/types.js"
    },
    "./schema/json/*": "./src/schema/json/*",
    "./search": {
      "types": "./dist/search/index.d.ts",
      "babizu-source": "./src/search/index.ts",
      "default": "./dist/search/index.js"
    },
    "./search/text": {
      "types": "./dist/search/text.d.ts",
      "babizu-source": "./src/search/text.ts",
      "default": "./dist/search/text.js"
    },
    "./pattern": {
      "types": "./dist/pattern/index.d.ts",
      "babizu-source": "./src/pattern/index.ts",
      "default": "./dist/pattern/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "babizu-source": "./src/pipeline/index.ts",
      "default": "./dist/pipeline/index.js"
    },
    "./pipeline/spreadsheet": {
      "types": "./dist/pipeline/spreadsheet.d.ts",
      "babizu-source": "./src/pipeline/spreadsheet.ts",
      "default": "./dist/pipeline/spreadsheet.js"
    },
    "./pipeline/docx": {
      "types": "./dist/pipeline/docx.d.ts",
      "babizu-source": "./src/pipeline/docx.ts",
      "default": "./dist/pipeline/docx.js"
    },
    "./dataset": {
      "types": "./dist/dataset.d.ts",
      "babizu-source": "./src/dataset.ts",
      "default": "./dist/dataset.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "babizu-source": "./src/site/index.ts",
      "default": "./dist/site/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#bcdp": {
      "types": "./packages/bcdp/dist/index.d.ts",
      "babizu-source": "./packages/bcdp/src/index.ts",
      "default": "./packages/bcdp/dist/index.js"
    },
    "#bcdp/*": "./packages/bcdp/src/*"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "app",
    "locales",
    "docs",
    "README.md",
    "tsconfig.json",
    "packages/bcdp/src",
    "packages/bcdp/dist",
    "packages/bcdp/package.json",
    "packages/bcdp/tsconfig.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run example:build && playwright test",
    "example:dev": "node --conditions=babizu-source bin/babizu.js dev examples/minimal",
    "example:build": "node --conditions=babizu-source bin/babizu.js build examples/minimal",
    "example:preview": "node --conditions=babizu-source bin/babizu.js preview examples/minimal",
    "bench": "node --conditions=babizu-source packages/bcdp/test/bench.js",
    "format": "prettier --write \"src/**/*.{js,json}\" \"app/src/**/*.{js,vue,css}\" \"test/**/*.js\" \"docs/**/*.md\" \"locales/*.json\"",
    "zoo": "node test/zoo/run.mjs"
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^15.0.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^18.0.14",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "peerDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": {
      "optional": true
    },
    "csv-parse": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "read-excel-file": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
