{
  "name": "babizu",
  "version": "0.1.0",
  "description": "多語言、可溯源的辭典網站框架：跨方言加權模糊搜尋、標準語料格式、多語系介面、靜態部署",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Babizu/babizu.git"
  },
  "bin": {
    "babizu": "./bin/babizu.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./fuzzy": "./src/fuzzy/index.js",
    "./schema": "./src/schema/index.js",
    "./schema/constants": "./src/schema/constants.js",
    "./schema/types": "./src/schema/types.js",
    "./schema/json/*": "./src/schema/json/*",
    "./search": "./src/search/index.js",
    "./search/text": "./src/search/text.js",
    "./pipeline": "./src/pipeline/index.js",
    "./pipeline/spreadsheet": "./src/pipeline/spreadsheet.js",
    "./pipeline/docx": "./src/pipeline/docx.js",
    "./dataset": "./src/dataset.js",
    "./site": "./src/site/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "app",
    "locales",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "npm run example:build && playwright test",
    "example:dev": "node bin/babizu.js dev examples/minimal",
    "example:build": "node bin/babizu.js build examples/minimal",
    "example:preview": "node bin/babizu.js preview examples/minimal",
    "bench": "node test/fuzzy/bench.js",
    "format": "prettier --write \"src/**/*.{js,json}\" \"app/src/**/*.{js,vue,css}\" \"test/**/*.js\" \"docs/**/*.md\" \"locales/*.json\""
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^15.0.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^18.0.14",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "peerDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": {
      "optional": true
    },
    "csv-parse": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "read-excel-file": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4",
    "vitest": "^5.0.1"
  }
}
