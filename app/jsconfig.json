{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@babizu/*": [
        "../src/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "checkJs": false,
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue"
  ]
}
